{
  "name": "csharp-razor-taghelpers",
  "displayName": "C# Razor Tag Helper Support",
  "description": "Enhanced C# and .NET development in VS Code with IntelliSense and hover support for custom Razor Tag Helpers.",
  "version": "1.0.8",
  "publisher": "M455YN",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/M455YN/csharp-razor-taghelpers"
  },
  "homepage": "https://github.com/M455YN/csharp-razor-taghelpers",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "razor",
    "taghelpers",
    "tag-helper",
    "aspnet",
    "aspnetcore",
    "csharp",
    "razor-pages",
    "vscode-extension"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:razor",
    "onLanguage:aspnetcorerazor",
    "onLanguage:csharp",
    "onStartupFinished"
  ],
  "icon": "logo.png",
  "contributes": {
    "commands": [
      {
        "command": "csharpRazorTagHelpers.refresh",
        "title": "C# Razor Tag Helper Support: Refresh",
        "category": "C# Razor Tag Helper Support"
      }
    ],
    "configuration": {
      "title": "C# Razor Tag Helper Support",
      "properties": {
        "csharpRazorTagHelpers.suppressCompletionsInStrings": {
          "type": "boolean",
          "default": true,
          "description": "Suppress Tag Helper completions when the cursor is inside a double-quoted string (including C# verbatim strings like @\"...\")."
        },
        "csharpRazorTagHelpers.autoTriggerEnumValueSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "Automatically trigger completion for enum-based attribute values when typing opening quotes (e.g. layout-type=\"...\")."
        }
      }
    }
  },
  "extensionDependencies": [
    "ms-dotnettools.csharp"
  ],
  "files": [
    "extension.js",
    "logo.png"
  ],
  "scripts": {
    "lint": "echo \"No lint configured\"",
    "test": "echo \"No tests yet\""
  }
}